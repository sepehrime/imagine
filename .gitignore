# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# Environment & Secrets (12-Factor App)
# Never commit credentials or local overrides
# ==========================================
.env
.env.local
.env.*.local
*.env

# ==========================================
# Node / Frontend (React + Vite)
# ==========================================
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Python / Backend (FastAPI + PyTorch)
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ==========================================
# Large ML Model Weights & Checkpoints
# Heavy binary weights should not be stored in Git
# ==========================================
*.pt
*.pth
*.bin
*.onnx
*.safetensors
backend/models/weights/

# ==========================================
# IDE / Editor Files
# ==========================================
.idea/
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
